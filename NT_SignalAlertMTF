namespace NinjaTrader.NinjaScript.Indicators
{
	public partial class Indicator : NinjaTrader.Gui.NinjaScript.IndicatorRenderBase
	{
		private SignalAlertMTF[] cacheSignalAlertMTF;
		public SignalAlertMTF SignalAlertMTF(int higherTFMinutes, int smaPeriod, int rocPeriod, int rsiPeriod, bool showBiasBackground, bool alertOnHigherTFSignal, bool alertOnHistorical, string alertSound)
		{
			return SignalAlertMTF(Input, higherTFMinutes, smaPeriod, rocPeriod, rsiPeriod, showBiasBackground, alertOnHigherTFSignal, alertOnHistorical, alertSound);
		}

		public SignalAlertMTF SignalAlertMTF(ISeries<double> input, int higherTFMinutes, int smaPeriod, int rocPeriod, int rsiPeriod, bool showBiasBackground, bool alertOnHigherTFSignal, bool alertOnHistorical, string alertSound)
		{
			if (cacheSignalAlertMTF != null)
				for (int idx = 0; idx < cacheSignalAlertMTF.Length; idx++)
					if (cacheSignalAlertMTF[idx] != null && cacheSignalAlertMTF[idx].HigherTFMinutes == higherTFMinutes && cacheSignalAlertMTF[idx].SmaPeriod == smaPeriod && cacheSignalAlertMTF[idx].RocPeriod == rocPeriod && cacheSignalAlertMTF[idx].RsiPeriod == rsiPeriod && cacheSignalAlertMTF[idx].ShowBiasBackground == showBiasBackground && cacheSignalAlertMTF[idx].AlertOnHigherTFSignal == alertOnHigherTFSignal && cacheSignalAlertMTF[idx].AlertOnHistorical == alertOnHistorical && cacheSignalAlertMTF[idx].AlertSound == alertSound && cacheSignalAlertMTF[idx].EqualsInput(input))
						return cacheSignalAlertMTF[idx];
			return CacheIndicator<SignalAlertMTF>(new SignalAlertMTF(){ HigherTFMinutes = higherTFMinutes, SmaPeriod = smaPeriod, RocPeriod = rocPeriod, RsiPeriod = rsiPeriod, ShowBiasBackground = showBiasBackground, AlertOnHigherTFSignal = alertOnHigherTFSignal, AlertOnHistorical = alertOnHistorical, AlertSound = alertSound }, input, ref cacheSignalAlertMTF);
		}
	}
}

